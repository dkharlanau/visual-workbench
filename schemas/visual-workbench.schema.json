{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/visual-workbench/schema/v1.json",
  "title": "Visual Workbench Markdown metadata",
  "type": "object",
  "required": ["visual"],
  "additionalProperties": true,
  "properties": { "visual": { "$ref": "#/$defs/visual" } },
  "$defs": {
    "visual": {
      "type": "object",
      "required": ["title", "nodes"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "integer", "minimum": 1, "default": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["process", "plan", "data-flow", "relationship", "system-flow", "checkpoint-flow", "roadmap", "timeline", "handoff", "dependency-map"], "default": "process" },
        "direction": { "enum": ["right", "down", "left", "up"], "default": "right" },
        "theme": { "enum": ["paper", "slate"], "default": "paper" },
        "density": { "enum": ["airy", "balanced", "compact"], "default": "balanced" },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" }, "default": [] },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" }, "default": [] },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" }, "default": [] },
        "views": { "type": "array", "items": { "$ref": "#/$defs/view" }, "default": [] },
        "projection": { "$ref": "#/$defs/projectionReport" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "const": "lane", "default": "lane" },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["step", "system", "data", "role", "decision", "checkpoint", "milestone", "outcome", "risk", "note"], "default": "step" },
        "subtitle": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "stage": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "status": { "enum": ["neutral", "success", "warning", "danger", "muted"], "default": "neutral" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "to": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["flow", "data", "dependency", "relation", "control", "exception"], "default": "flow" },
        "status": { "enum": ["neutral", "success", "warning", "danger", "muted"], "default": "neutral" },
        "note": { "type": "string", "minLength": 1 },
        "projection": { "$ref": "#/$defs/edgeProjection" }
      }
    },
    "edgeProjection": {
      "type": "object",
      "required": ["kind", "pathCount", "aggregation"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "collapsed-path" },
        "pathCount": { "type": "integer", "minimum": 1 },
        "hiddenNodeIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "default": [] },
        "hiddenRiskNodeIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "default": [] },
        "sourcePathRefs": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 }, "default": [] },
        "sourcePathRefsTruncated": { "type": "boolean", "default": false },
        "aggregation": { "const": "conservative-max-severity" },
        "limited": { "type": "boolean", "default": false },
        "limitReasons": { "type": "array", "items": { "enum": ["depth", "cycle", "budget"] }, "default": [] }
      }
    },
    "projectionReport": {
      "type": "object",
      "required": ["viewId", "sourceNodeCount", "visibleNodeCount", "sourceEdgeCount", "projectedEdgeCount", "collapsedEdgeCount", "maxHiddenDepth", "maxExplorationStatesPerSource", "maxSourcePathRefsPerBridge"],
      "additionalProperties": false,
      "properties": {
        "viewId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "sourceNodeCount": { "type": "integer", "minimum": 0 },
        "visibleNodeCount": { "type": "integer", "minimum": 0 },
        "sourceEdgeCount": { "type": "integer", "minimum": 0 },
        "projectedEdgeCount": { "type": "integer", "minimum": 0 },
        "collapsedEdgeCount": { "type": "integer", "minimum": 0 },
        "hiddenNodeIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "default": [] },
        "hiddenRiskNodeIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }, "default": [] },
        "limited": { "type": "boolean", "default": false },
        "limitReasons": { "type": "array", "items": { "enum": ["depth", "cycle", "budget"] }, "default": [] },
        "maxHiddenDepth": { "type": "integer", "minimum": 1 },
        "maxExplorationStatesPerSource": { "type": "integer", "minimum": 1 },
        "maxSourcePathRefsPerBridge": { "type": "integer", "minimum": 1 }
      }
    },
    "view": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "focus": { "enum": ["all", "executive", "flow", "data", "controls", "exceptions"], "default": "all" },
        "kind": { "enum": ["process", "plan", "data-flow", "relationship", "system-flow", "checkpoint-flow", "roadmap", "timeline", "handoff", "dependency-map"] },
        "direction": { "enum": ["right", "down", "left", "up"] },
        "theme": { "enum": ["paper", "slate"] },
        "density": { "enum": ["airy", "balanced", "compact"] },
        "includeNodeTypes": { "$ref": "#/$defs/nodeTypeArray" },
        "excludeNodeTypes": { "$ref": "#/$defs/nodeTypeArray" },
        "includeGroups": { "$ref": "#/$defs/idArray" },
        "excludeGroups": { "$ref": "#/$defs/idArray" },
        "includeStages": { "$ref": "#/$defs/idArray" },
        "excludeStages": { "$ref": "#/$defs/idArray" },
        "includeTags": { "$ref": "#/$defs/stringArray" },
        "statuses": { "type": "array", "minItems": 1, "items": { "enum": ["neutral", "success", "warning", "danger", "muted"] } },
        "includeEdgeTypes": { "$ref": "#/$defs/edgeTypeArray" },
        "excludeEdgeTypes": { "$ref": "#/$defs/edgeTypeArray" }
      }
    },
    "nodeTypeArray": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["step", "system", "data", "role", "decision", "checkpoint", "milestone", "outcome", "risk", "note"] }
    },
    "edgeTypeArray": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["flow", "data", "dependency", "relation", "control", "exception"] }
    },
    "idArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
